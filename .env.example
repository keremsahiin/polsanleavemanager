# Polsan İzin Yönetimi — örnek ortam dosyası (docs/development.md).
# Kopyalayıp kullanın: .env dosyası gitignore'dadır ve asla commit'lenmez.
# Bu dosya hiçbir sır içermez; ileride bir sır eklenirse burada yalnız adı ve açıklaması durur.

# Zorunlu. SQLite veritabanı dosyasının yolu; varsayılanı yoktur. Dosyayı yalnız şema güncelleme
# komutu (alembic upgrade head) oluşturur; klasörü önceden oluşturun.
PLM_DATABASE_PATH=data/plm.db

# İsteğe bağlı. Dinlenecek adres; varsayılan 127.0.0.1 (erişim yalnız ters proxy üzerinden).
PLM_HOST=127.0.0.1

# İsteğe bağlı. Dinlenecek port; varsayılan 8000.
PLM_PORT=8000
